# Copy to .env and fill in real values for production runs.

# Required for real LLM-backed runs.
GENERATOR_MODEL=
JUDGE_MODEL=
OPENAI_API_KEY=

# Required for real web evidence collection.
TAVILY_API_KEY=

# Optional RAG runtime controls.
RAG_ENABLED=true
RAG_INDEX_PATH=outputs/rag/index-400-reviewed.sqlite
USE_CACHE=true

# LangSmith tracing. 동적 라우팅·재작업 루프를 트레이스로 확인할 때 켠다.
# config.py의 load_dotenv가 읽어 LangChain/LangGraph가 자동으로 사용한다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=capstone-supervisor
